{
  "name": "fdds-memo",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm install && vite",
    "build": "pnpm clean-install --prod && vite build --sourcemap",
    "build-debug": "pnpm install --prod && vite build --no-minify --sourcemap=inline",
    "clean-build": "rm -rf public/build",
    "format": "pnpm install && prettier resources/js --write",
    "typecheck": "pnpm install && tsc --noEmit",
    "typecheck-watch": "pnpm install && tsc --noEmit --watch",
    "test": "pnpm install && vitest run",
    "test-watch": "pnpm install && vitest watch",
    "coverage": "pnpm install && vitest run --coverage",
    "lint": "pnpm install && eslint resources/js",
    "playwright-typecheck": "pnpm install && tsc --noEmit -p playwright/tsconfig.json",
    "playwright-lint": "pnpm install && eslint --config playwright/eslint.config.mjs playwright",
    "checks": "pnpm install && tsc --noEmit && eslint resources/js && tsc --noEmit -p playwright/tsconfig.json && eslint --config playwright/eslint.config.mjs playwright",
    ":playwright": "playwright test -c playwright/playwright.config.ts",
    ":playwright-happy": "MEMO_E2E_CONFIG=playwright/config/config.happy.json playwright test -c playwright/playwright.config.ts --project=chromium --grep @happy",
    ":playwright-rep": "playwright show-report playwright/playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/wicg-file-system-access": "^2023.10.7",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@felte/core": "^1.4.4",
    "@felte/reporter-solid": "^1.2.11",
    "@felte/solid": "^1.2.14",
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/dom": "^1.8.0",
    "@mbarzda/solid-i18next": "^1.4.1",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-query": "^5.105.0",
    "@tanstack/solid-table": "^8.21.3",
    "@tanstack/table-core": "^8.21.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "axios": "^1.20.0",
    "bowser": "^2.14.1",
    "classnames": "^2.5.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.18.1",
    "headless-qr": "^1.0.3",
    "html-parse-string": "^0.0.9",
    "i18next": "^26.5.11",
    "i18next-http-backend": "^4.0.6",
    "i18next-intervalplural-postprocessor": "^3.0.0",
    "js-base64": "^3.9.4",
    "laravel-vite-plugin": "^3.2.0",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "rehype-autolink-headings": "^7.1.0",
    "remark-custom-heading-id": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.17",
    "solid-markdown": "^2.1.1",
    "solid-toast": "^0.5.0",
    "tailwindcss": "^4.3.3",
    "tippy.js": "^6.3.7",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-solid-svg": "^0.8.1",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11",
    "npm": "use-pnpm-instead"
  }
}
