{
  "name": "fdds-memo",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm install && vite",
    "build": "pnpm clean-install --prod && vite build --sourcemap",
    "build-debug": "pnpm install --prod && vite build --no-minify --sourcemap=inline",
    "clean": "rm -rf public/build",
    "format": "pnpm install && prettier resources/js --write",
    "typecheck": "pnpm install && tsc --noEmit",
    "typecheck-watch": "pnpm install && tsc --noEmit --watch",
    "test": "pnpm install && vitest run",
    "test-watch": "pnpm install && vitest watch",
    "coverage": "pnpm install && vitest run --coverage",
    "lint": "pnpm install && eslint resources/js"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/luxon": "^3.7.4",
    "@types/wicg-file-system-access": "^2023.10.7",
    "eslint": "^9.39.5",
    "eslint-config-love": "^154.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@felte/core": "^1.4.4",
    "@felte/reporter-solid": "^1.2.11",
    "@felte/solid": "^1.2.14",
    "@felte/validator-zod": "^1.0.18",
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/dom": "^1.8.0",
    "@mbarzda/solid-i18next": "^1.4.1",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-table": "^8.21.3",
    "@tanstack/table-core": "^8.21.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "axios": "^1.19.0",
    "bowser": "^2.14.1",
    "classnames": "^2.5.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.14.5",
    "headless-qr": "^1.0.3",
    "html-parse-string": "^0.0.9",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^4.0.1",
    "i18next-intervalplural-postprocessor": "^3.0.0",
    "js-base64": "^3.9.2",
    "laravel-vite-plugin": "^3.1.3",
    "libphonenumber-js": "^1.13.10",
    "luxon": "^3.7.2",
    "rehype-autolink-headings": "^7.1.0",
    "remark-custom-heading-id": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.14",
    "solid-markdown": "^2.1.1",
    "solid-toast": "^0.5.0",
    "tailwindcss": "^4.3.3",
    "tippy.js": "^6.3.7",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-solid-svg": "^0.8.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11",
    "npm": "use-pnpm-instead"
  }
}
